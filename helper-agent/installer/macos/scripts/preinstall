#!/bin/sh
# Stop a previously installed agent so the upgrade does not leave the old
# binary listening on 127.0.0.1:17357. Runs as root.
LABEL="bg.easypdfsign.helper"

CONSOLE_USER="$(stat -f%Su /dev/console 2>/dev/null || echo '')"
case "$CONSOLE_USER" in
  ''|root|loginwindow) exit 0 ;;
esac

CONSOLE_UID="$(id -u "$CONSOLE_USER" 2>/dev/null)" || exit 0

launchctl bootout "gui/$CONSOLE_UID/$LABEL" 2>/dev/null ||
  launchctl unload -w "/Library/LaunchAgents/$LABEL.plist" 2>/dev/null || true

exit 0
