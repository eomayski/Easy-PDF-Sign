#!/bin/sh
# Load + start the LaunchAgent for the user who is sitting at the machine, so
# the agent is usable immediately — no logout/reboot. Runs as root.
#
# The plist lives in /Library/LaunchAgents, so every *other* user gets it
# automatically at their next login.
LABEL="bg.easypdfsign.helper"
PLIST="/Library/LaunchAgents/$LABEL.plist"

chown root:wheel "$PLIST" 2>/dev/null || true
chmod 644 "$PLIST" 2>/dev/null || true

CONSOLE_USER="$(stat -f%Su /dev/console 2>/dev/null || echo '')"
case "$CONSOLE_USER" in
  ''|root|loginwindow) exit 0 ;;   # no GUI session — the agent starts at next login
esac

CONSOLE_UID="$(id -u "$CONSOLE_USER" 2>/dev/null)" || exit 0

launchctl bootout "gui/$CONSOLE_UID/$LABEL" 2>/dev/null || true
launchctl bootstrap "gui/$CONSOLE_UID" "$PLIST" 2>/dev/null ||
  launchctl load -w "$PLIST" 2>/dev/null || true
launchctl kickstart "gui/$CONSOLE_UID/$LABEL" 2>/dev/null || true

# Never fail the install because of launchctl — the login item covers it.
exit 0
