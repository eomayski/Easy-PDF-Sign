<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>bg.easypdfsign.helper</string>

  <!-- Wrapper picks the arm64 / x86_64 slice at runtime. -->
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/easy-pdf-sign-helper</string>
  </array>

  <!-- LaunchAgent (not Daemon) on purpose: the PIN prompt is an osascript
       dialog, so the process must live in the user's GUI (Aqua) session. -->
  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>

  <key>ThrottleInterval</key>
  <integer>10</integer>

  <key>ProcessType</key>
  <string>Interactive</string>
</dict>
</plist>
