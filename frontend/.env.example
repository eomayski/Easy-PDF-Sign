# Supabase project (Phase 2´ — auth). Create the project in eu-central
# (Frankfurt) and copy these from Dashboard → Settings → API Keys.
# Both values are public (the publishable key is designed for browsers).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Upload size policy — MUST mirror the backend values (FREE_UPLOAD_SIZE_MB,
# CREDIT_STEP_SIZE_MB, MAX_UPLOAD_SIZE_MB). Used only to show the credit cost
# before the upload starts; the backend is the authority and re-checks.
# Defaults if unset: 5 / 5 / 200.
VITE_FREE_UPLOAD_SIZE_MB=5
VITE_CREDIT_STEP_SIZE_MB=5
VITE_MAX_UPLOAD_SIZE_MB=200
